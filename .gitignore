# cross-national archived policy-page HTML; regenerate with patient_scale.py / patient_round.py
j9_aipolicy/crossnational/data/snapshots_raw/
# raw HESA Figure-7 download (18 MB); regenerate with uk_hesa_get.py
j9_aipolicy/crossnational/uk_hesa.csv
# cached raw API pulls (CCD/EDFacts/CRDC) + per-state report-card downloads; regenerate with the fetchers
j10_accountability/data/raw/

